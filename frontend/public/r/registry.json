      "name": "the-zip",
      "type": "registry:block",
      "title": "The Zip",
      "description": "An isometric zip in SVG. Two tapes bow apart past the slider and their teeth mesh behind it; one number drives the tapes, every tooth and the slider body. It runs its own idle tour with a play/pause control, and once paused you can drag the slider or drive it with the arrow keys.",
      "categories": ["svg", "isometric", "interactive"],
      "dependencies": ["@hugeicons/react", "@hugeicons/core-free-icons"],
